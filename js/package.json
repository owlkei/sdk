{
  "name": "@owlkei/sdk",
  "version": "0.0.0",
  "description": "Client SDK for Owlkei Go apps: WebSocket first, HTTP and more later",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./ws": {
      "types": "./dist/ws/index.d.ts",
      "default": "./dist/ws/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "size": "size-limit",
    "package:check": "publint --pack npm && attw --pack . --profile esm-only",
    "check": "yarn format:check && yarn lint && yarn typecheck && yarn test && yarn build && yarn package:check && yarn size"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@size-limit/preset-small-lib": "14.3.0",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "size-limit": "14.3.0",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
