{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/owlkei/sdk/spec/devtools/v1/vector.schema.json",
  "title": "Owlkei devtools protocol v1 test vector",
  "type": "object",
  "required": [
    "name",
    "kind",
    "description",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "kind": {
      "const": "session"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[GKLSTV][0-9]+$"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "additionalProperties": false,
        "properties": {
          "send": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "binary": {
                "type": "object",
                "required": [
                  "envelope"
                ],
                "additionalProperties": false,
                "properties": {
                  "envelope": {
                    "type": "string"
                  },
                  "dataBase64": {
                    "type": "string"
                  }
                }
              },
              "frameBase64": {
                "type": "string"
              }
            }
          },
          "expect": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "additionalProperties": false,
            "properties": {
              "json": {
                "type": "object"
              },
              "binary": {
                "type": "object",
                "required": [
                  "json"
                ],
                "additionalProperties": false,
                "properties": {
                  "json": {
                    "type": "object"
                  },
                  "dataBase64": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "expectClose": {
            "type": "object",
            "required": [
              "code"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4999
              }
            }
          },
          "wait": {
            "type": "object",
            "required": [
              "ms"
            ],
            "additionalProperties": false,
            "properties": {
              "ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            }
          }
        }
      }
    }
  }
}
