{
  "name": "data-not-object",
  "kind": "session",
  "description": "data that is not an object where the handler reads an object is 400",
  "rules": [
    "V12"
  ],
  "steps": [
    {
      "send": {
        "text": "{\"type\":\"subscribe\",\"id\":\"1\",\"topic\":\"validated\"}"
      }
    },
    {
      "expect": {
        "json": {
          "type": "ack",
          "id": "1",
          "requestId": "@id"
        }
      }
    },
    {
      "send": {
        "text": "{\"type\":\"publish\",\"id\":\"2\",\"topic\":\"validated\",\"data\":[1]}"
      }
    },
    {
      "expect": {
        "json": {
          "type": "error",
          "id": "2",
          "requestId": "@same:rid2",
          "error": {
            "code": 400,
            "error": "Bad Request",
            "message": "Invalid message",
            "requestId": "@same:rid2"
          },
          "retryAfter": "@absent"
        }
      }
    }
  ]
}
