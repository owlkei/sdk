{
  "name": "binary-to-text-topic",
  "kind": "session",
  "description": "a binary publish to a JSON topic is 415",
  "rules": [
    "V12"
  ],
  "steps": [
    {
      "send": {
        "text": "{\"type\":\"subscribe\",\"id\":\"1\",\"topic\":\"echo\"}"
      }
    },
    {
      "expect": {
        "json": {
          "type": "ack",
          "id": "1",
          "requestId": "@id"
        }
      }
    },
    {
      "send": {
        "binary": {
          "envelope": "{\"type\":\"publish\",\"id\":\"2\",\"topic\":\"echo\"}",
          "dataBase64": "eA=="
        }
      }
    },
    {
      "expect": {
        "json": {
          "type": "error",
          "id": "2",
          "requestId": "@same:rid2",
          "error": {
            "code": 415,
            "error": "Unsupported Media Type",
            "message": "Unsupported Media Type",
            "requestId": "@same:rid2"
          },
          "retryAfter": "@absent"
        }
      }
    }
  ]
}
