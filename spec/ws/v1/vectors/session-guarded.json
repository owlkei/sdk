{
  "name": "guarded",
  "kind": "session",
  "description": "a guard's refusal is 403 with the application's message",
  "rules": [
    "V12"
  ],
  "steps": [
    {
      "send": {
        "text": "{\"type\":\"subscribe\",\"id\":\"1\",\"topic\":\"guarded\"}"
      }
    },
    {
      "expect": {
        "json": {
          "type": "error",
          "id": "1",
          "requestId": "@same:rid1",
          "error": {
            "code": 403,
            "error": "Forbidden",
            "message": "Forbidden",
            "requestId": "@same:rid1"
          },
          "retryAfter": "@absent"
        }
      }
    }
  ]
}
