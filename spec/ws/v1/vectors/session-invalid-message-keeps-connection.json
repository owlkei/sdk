{
  "name": "invalid-message-keeps-connection",
  "kind": "session",
  "description": "an invalid envelope is answered 400 without an id and the connection stays open",
  "rules": [
    "V11",
    "V12"
  ],
  "steps": [
    {
      "send": {
        "text": "hello"
      }
    },
    {
      "expect": {
        "json": {
          "type": "error",
          "id": "@absent",
          "requestId": "@same:rid",
          "error": {
            "code": 400,
            "error": "Bad Request",
            "message": "Invalid message",
            "requestId": "@same:rid"
          },
          "retryAfter": "@absent"
        }
      }
    },
    {
      "send": {
        "text": "{\"type\":\"ping\",\"id\":\"p2\"}"
      }
    },
    {
      "expect": {
        "json": {
          "type": "pong",
          "id": "p2"
        }
      }
    }
  ]
}
