{
  "name": "me-anonymous-401",
  "kind": "session",
  "description": "an anonymous connection that subscribes to the per-user topic ~me is refused with 401 and stays open",
  "rules": [
    "V12"
  ],
  "steps": [
    {
      "send": {
        "text": "{\"type\":\"subscribe\",\"id\":\"1\",\"topic\":\"~me\"}"
      }
    },
    {
      "expect": {
        "json": {
          "type": "error",
          "id": "1",
          "requestId": "@same:rid1",
          "error": {
            "code": 401,
            "error": "Unauthorized",
            "message": "Unauthorized",
            "requestId": "@same:rid1"
          },
          "retryAfter": "@absent"
        }
      }
    },
    {
      "send": {
        "text": "{\"type\":\"ping\",\"id\":\"2\"}"
      }
    },
    {
      "expect": {
        "json": {
          "type": "pong",
          "id": "2"
        }
      }
    }
  ]
}
